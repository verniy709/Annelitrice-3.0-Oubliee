	<!--Anneli_Oubliee_Bandage-->
	<ThingDef ParentName="Anneli_Oubliee_6BC_NonMetal">
		<defName>Anneli_Oubliee_Bandage</defName>
		<description>Dyeable.</description>
		<label>(Oubliee)6BC_Bandage</label>
		<graphicData>
			<texPath>6BC/Bandage/Anneli_Oubliee_BandageC</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>6BC/Bandage/Anneli_Oubliee_BandageC</wornGraphicPath>
			<tags>
				<li>Anneli_Oubliee_MaidenA</li>
				<li>Anneli_Oubliee_Sergeant</li>
				<li>Anneli_Oubliee_Guard</li>
				<li>Anneli_Oubliee_Private</li>
				<li>Anneli_Oubliee_Drummer</li>
				<li>Anneli_Oubliee_Militia</li>
				<li>Anneli_Oubliee_Hussar</li>
				<li>Anneli_Oubliee_Cuirassier</li>
				<li>Anneli_Oubliee_Carabinier</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(255,245,245,255)</only>
				</li>
			</options>
		</colorGenerator>
		<generateAllowChance>0.1</generateAllowChance><!--Less Spawn-->
	</ThingDef>

