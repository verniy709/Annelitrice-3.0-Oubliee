<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef Name="Anneli_Oubliee_8A" ParentName="Anneli_8A" Abstract="True">
		<thingCategories>
			<li>Anneli_Category_Oubliee</li>
		</thingCategories>
		<recipeMaker>
			<recipeUsers>
				<li>Anneli_Oubliee_Workbench</li>
			</recipeUsers>
		</recipeMaker>
	</ThingDef>

	<!-- Anneli_MarchingSongA-->
	<SoundDef>
		<defName>Anneli_MarchingSongA</defName>
		<context>MapOnly</context>
		<sustain>True</sustain>
		<maxSimultaneous>1</maxSimultaneous>
		<priorityMode>PrioritizeNearest</priorityMode>
		<subSounds>
			<li>
				<muteWhenPaused>True</muteWhenPaused>
				<sustainLoop>False</sustainLoop>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Anneli_MarchingSongA</clipPath>
					</li>
				</grains>
				<volumeRange>60~60</volumeRange>
			</li>
		</subSounds>
	</SoundDef>

	<!-- Anneli_MarchingSongB-->
	<SoundDef>
		<defName>Anneli_MarchingSongB</defName>
		<context>MapOnly</context>
		<sustain>True</sustain>
		<maxSimultaneous>1</maxSimultaneous>
		<priorityMode>PrioritizeNearest</priorityMode>
		<subSounds>
			<li>
				<muteWhenPaused>True</muteWhenPaused>
				<sustainLoop>False</sustainLoop>
				<grains>
					<li Class="AudioGrain_Clip">
						<clipPath>Anneli_MarchingSongB</clipPath>
					</li>
				</grains>
				<volumeRange>55~55</volumeRange>
			</li>
		</subSounds>
	</SoundDef>

	<!--Anneli_Oubliee_Drum-->
	<ThingDef ParentName="Anneli_Oubliee_8A">
		<defName>Anneli_Oubliee_Drum</defName>
		<description>Dyeable.</description>
		<label>(Oubliee)8A_Drum</label>
		<graphicData>
			<texPath>8A/Anneli_Oubliee_Drum</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>8A/Anneli_Oubliee_Drum</wornGraphicPath>
			<tags>
				<li>Anneli_Oubliee_Drummer</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(220,55,45,255)</only>
				</li>
			</options>
		</colorGenerator>
		<generateAllowChance>0.0</generateAllowChance><!--Less Spawn-->
		<costStuffCount>20</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<statBases>
			<WorkToMake>200</WorkToMake>
			<Mass>1</Mass>
			<StuffEffectMultiplierArmor>0.05</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.05</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.05</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1</EquipDelay>
			<Flammability>0.15</Flammability>
		</statBases>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="Annelitrice.CompProperties_ApparelCauseHediff_AoE">
				<hediff>Anneli_Music_Intense</hediff>
				<range>21.9</range>
				<canTargetSelf>true</canTargetSelf>
				<drawLines>false</drawLines>
				<ignoreMechs>true</ignoreMechs>
				<checkInterval>500</checkInterval>
			</li>
			<li Class="Annelitrice.CompProperties_PlayMusic">
				<soundDefs>
					<li>Anneli_MarchingSongA</li>
					<li>Anneli_MarchingSongB</li>
				</soundDefs>
				<effecters>
					<li>Anneli_Effecter_Note1</li>
					<li>Anneli_Effecter_Note2</li>
					<li>Anneli_Effecter_Note3</li>
				</effecters>
			</li>
		</comps>
	</ThingDef>	

	<!--Anneli_Oubliee_Saber-->
	<ThingDef ParentName="Anneli_Oubliee_8A">
		<defName>Anneli_Oubliee_Saber</defName>
		<description>Dyeable.</description>
		<label>(Oubliee)8A_Saber</label>
		<costStuffCount>20</costStuffCount>
		<stuffCategories>
			<li>Metallic</li>
		</stuffCategories>
		<statBases>
			<WorkToMake>200</WorkToMake>
			<Mass>1</Mass>
			<StuffEffectMultiplierArmor>0.01</StuffEffectMultiplierArmor>
			<StuffEffectMultiplierInsulation_Cold>0.01</StuffEffectMultiplierInsulation_Cold>
			<StuffEffectMultiplierInsulation_Heat>0.01</StuffEffectMultiplierInsulation_Heat>
			<EquipDelay>1</EquipDelay>
			<Flammability>0.15</Flammability>
		</statBases>
		<equippedStatOffsets>
		</equippedStatOffsets>
		<graphicData>
			<texPath>8A/Anneli_Oubliee_Saber</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<apparel>
			<wornGraphicPath>8A/Anneli_Oubliee_Saber</wornGraphicPath>
			<tags>
				<li>Anneli_Oubliee_General</li>
			</tags>
			<useWornGraphicMask>true</useWornGraphicMask><!--Mask Applied-->
		</apparel>
		<colorGenerator Class="ColorGenerator_Options">
			<options>
				<li>
					<weight>10</weight>
					<only>(220,55,45,255)</only>
				</li>
			</options>
		</colorGenerator>
		<tickerType>Normal</tickerType>
		<comps>
			<li Class="Annelitrice.CompProperties_ApparelCauseHediff_AoE">
				<hediff>Anneli_Aura_Bravery</hediff>
				<range>21.9</range>
				<canTargetSelf>true</canTargetSelf>
				<drawLines>false</drawLines>
				<ignoreMechs>true</ignoreMechs>
				<checkInterval>500</checkInterval>
			</li>
		</comps>
	</ThingDef>

</Defs>